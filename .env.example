# ---------------------------------------------------------------------------
# Keystatic GitHub storage
#
# The fastest way to fill these in is the guided setup: run `npm run dev` and
# open http://127.0.0.1:3000/keystatic. Keystatic creates the GitHub App for you
# and writes the four values below into a local `.env` file (gitignored). Copy
# that same `.env` into the Vercel project's environment variables.
#
# Fill in the setup screen's "Deployed URL" field with your Vercel URL, so the
# production OAuth callback is registered at the same time as the local one.
#
# Creating the App by hand instead? See README.md -> "Connecting to GitHub".
# ---------------------------------------------------------------------------

# From the GitHub App's settings page.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Signs the Keystatic session cookie. Any long random string:
#   openssl rand -hex 40
KEYSTATIC_SECRET=

# The App's slug, i.e. the last part of https://github.com/apps/<slug>.
# Keystatic uses it to send editors to the "install this app" screen.
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------

# The repo Keystatic commits to. Defaults to fltanveer/knowledge-base, so these
# are only needed on a fork.
# NEXT_PUBLIC_KEYSTATIC_GITHUB_OWNER=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=

# Set to "local" to edit the files in your working copy instead of committing to
# GitHub. Useful offline or before the GitHub App exists. Anything else (or
# unset) means GitHub storage.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=local
